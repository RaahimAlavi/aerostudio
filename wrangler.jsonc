{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aero-studio",
  "main": "worker/index.js",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./cf-dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "AERO_ROOM",
        "class_name": "AeroRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AeroRoom"]
    }
  ]
}
